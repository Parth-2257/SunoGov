# Global Environment Variables Example
# Duplicate this file as '.env' at the root level and in frontend/backend dirs as needed.

# ==========================================
# Frontend Configuration
# ==========================================
# Base URL for the FastAPI backend service API
VITE_API_URL=http://localhost:8000/api

# ==========================================
# Backend Configuration
# ==========================================
# Server port for FastAPI
PORT=8000

# OpenAI API Key (Planned for Phase 2 - AI Integration)
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Connection String (Planned for Phase 2 - Persistence Layer)
MONGODB_URI=mongodb://localhost:27017/sunogov
