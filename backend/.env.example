# SunoGov Backend Environment Variables

PORT=8000
HOST=0.0.0.0

# CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. for Render deployment)
# Development: http://localhost:5173
# Production: https://your-frontend.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Configuration (OpenRouter integration with GLM-5.3 Flash)
# Options: mock, openrouter
AI_PROVIDER=mock
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_CONFIDENCE_THRESHOLD=0.50

# Bhashini / AI4Bharat Voice Integration (Placeholders Only)
BHASHINI_API_KEY=YOUR_BHASHINI_API_KEY
BHASHINI_USER_ID=YOUR_BHASHINI_USER_ID
BHASHINI_APP_ID=YOUR_BHASHINI_APP_ID
BHASHINI_BASE_URL=https://dhruva.ai4bharat.org

# Future Integrations (Optional)
MONGODB_URI=mongodb://localhost:27017/sunogov
